{
  "name": "playground",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && node esbuild.js",
    "start": "npm run build && clear && node dist/index.cjs",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/aws": "workspace:*",
    "@repo/shared": "workspace:*",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@repo/aws": "workspace:*",
    "@repo/shared": "workspace:*",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.8",
    "rollup": "^3.29.4",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "^5.3.3"
  }
}
