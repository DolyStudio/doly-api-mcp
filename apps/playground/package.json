    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@repo/shared": "workspace:*",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.3",
    "rollup": "^4.45.1",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "^5.8.3"
